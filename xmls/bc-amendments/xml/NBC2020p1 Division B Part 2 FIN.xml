                                    <sentence xml:id="nbc.divB.part2.sect1.subsect1.art1.sent1" number="1">
                                        <text>RESERVED</text>
                                    </sentence>
                                </article>
                            </subsection>
                        </section>
                    </part>
                </new-content>
            </replace>
        </amendment>

